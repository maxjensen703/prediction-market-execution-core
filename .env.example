# Copy to .env and fill in. .env is gitignored; this template is committed, so keep it blank.
# Market-data reads are public and keyless. These are needed only to sign account calls and orders.
# config.py loads ./.env from the current working directory at import; real environment variables win.

# Live-trading gate. Default off. Set to 1 to let the live brokers' place_order()/unwind() send orders (see README).
LIVE_TRADING_ENABLED=

# Kalshi trading API base URL. Blank = production (https://external-api.kalshi.com/trade-api/v2).
KALSHI_API_BASE=
# Kalshi API key id, sent as the KALSHI-ACCESS-KEY header.
KALSHI_API_KEY_ID=
# Path to your Kalshi RSA private key PEM file, used for RSA-PSS request signing.
KALSHI_PRIVATE_KEY_PATH=

# Polymarket US trading API base URL. Blank = https://api.polymarket.us.
POLYMARKET_US_API_BASE=
# Polymarket US key id, sent as the X-PM-Access-Key header.
POLYMARKET_US_API_KEY=
# Polymarket US Ed25519 secret key (base64 or hex seed, or PEM), used to sign requests.
POLYMARKET_US_PRIVATE_KEY=
